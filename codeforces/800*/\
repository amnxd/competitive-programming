#pragma GCC optimize ("O3")
#include <bits/stdc++.h>

int main() {
    std::cin.tie(0)->sync_with_stdio(0);
    int t;
    std::cin >> t;

    while(t--) {
        int n, k;
        std::cin >> n >> k;

        std::string s;
        std::cin >> s;
				
				bool flag = true;
				int l = n-1;

				for(int i=0; i<n/2; i++){
						if(s[i] == s[l]) l--;
						else if(k > 0){
								int tl = l;
								for(int j = i; j < l; j++){
										if(s[i] == s[tl]){
											l = tl;
											i = j;
												break;
										}
										else tl--; k--;
								}						
						}
						else flag = false;
				}
				
				std::cout << ( flag ? "YES\n" : "NO\n" );
    }
}

